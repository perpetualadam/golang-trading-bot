# Put ".env" in the project root (same folder you run `go run` from), or next to config
# (e.g. configs/.env when using -config configs/config.yaml).
# Values here override YAML via Viper / explicit env overrides.

# Telegram (keep token out of config.yaml). One line, no spaces around =, no quotes.
TRADING_TELEGRAM_BOT_TOKEN=
# Aliases also work: TELEGRAM_BOT_TOKEN, BOT_TOKEN
# Or put token in a file (single line) and set:
# TRADING_TELEGRAM_TOKEN_FILE=C:\secrets\telegram_token.txt
# Optional: turn Telegram on without editing YAML (true/1/yes/on)
# TRADING_TELEGRAM_ENABLED=true
# Optional: comma-separated numeric user ids; if unset, any Telegram user can use commands
# TRADING_TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
# Optional: chat ids to receive the same automated report as /report (hourly by default); overrides YAML if set
TRADING_TELEGRAM_REPORT_CHAT_IDS=123456789
#
# ML / ml_meta: remote inference URL (POST JSON features); see internal/ml/http_infer.go
# TRADING_ML_ENABLE_REMOTE_INFER_URL=http://127.0.0.1:8088/infer

# OANDA FX: put the v20 token in config.fx.yaml exchanges.oanda.api_key_enc (or main config).
# Optional: encrypt with cmd/secrets + TRADING_MASTER_KEY (same as other venues).
#
# Encrypted exchange keys in config.yaml (api_key_enc, api_secret_enc, passphrase_enc):
# 1. Set a long random secret here (never commit .env).
# 2. Offline: go run ./cmd/secrets encrypt "your_plain_api_key"  → paste output into YAML.
# 3. At runtime the bot sets TRADING_MASTER_KEY and decrypts those fields in memory.
TRADING_MASTER_KEY=
